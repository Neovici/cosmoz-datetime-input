{
  "name": "@neovici/cosmoz-datetime-input",
  "version": "5.0.0",
  "description": "Mimics date input with broad browser support.",
  "keywords": [
    "datepicker",
    "datetime local",
    "polymer",
    "web-components"
  ],
  "homepage": "https://github.com/Neovici/cosmoz-datetime-input#readme",
  "bugs": {
    "url": "https://github.com/Neovici/cosmoz-datetime-input/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neovici/cosmoz-datetime-input.git"
  },
  "license": "Apache-2.0",
  "author": "Neovici Development",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "types"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./cosmoz-datetime-input": "./dist/cosmoz-datetime-input.js"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "check:duplicates": "check-duplicate-components",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run storybook:start",
    "test": "wtr --coverage",
    "test:watch": "wtr --watch",
    "prepare": "husky install",
    "storybook:start": "storybook dev -p 8000",
    "storybook:build": "storybook build",
    "storybook:deploy": "storybook-to-ghpages",
    "storybook:preview": "npm run storybook:build && http-server ./storybook-static/ --silent",
    "changeset": "changeset"
  },
  "dependencies": {
    "@neovici/cosmoz-input": "^6.0.0",
    "@neovici/cosmoz-tokens": "^3.4.0",
    "@neovici/cosmoz-utils": "^6.20.1",
    "@pionjs/pion": "^2.13.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@neovici/cfg": "^2.11.1",
    "@open-wc/testing": "^4.0.0",
    "@storybook/web-components-vite": "^10.2.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-storybook": "^10.3.5",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.7",
    "shadow-dom-testing-library": "^1.13.1",
    "sinon": "^19.0.0",
    "storybook": "^10.0.0",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
